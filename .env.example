# Copy to .env and adjust. .env is gitignored.
# Default: local SQLite file (no database server needed)
MIGRATERIGHT_DB_URL=sqlite:///data/migrateright.db

# PostgreSQL example (docker-compose maps Postgres to host port 5450)
# MIGRATERIGHT_DB_URL=postgresql+psycopg2://migrateright:change_me@localhost:5450/migrateright
POSTGRES_USER=migrateright
POSTGRES_PASSWORD=change_me
POSTGRES_DB=migrateright
